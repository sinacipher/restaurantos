# ============================================================
# RestaurantOS - Environment Variables
# ============================================================
# Placeholder template. Copy to .env.local and fill in real values.
# NEVER commit .env.local. NEVER put real secrets in this file.
# ============================================================

# ---------- Database (Neon) ----------
# Pooled connection - runtime.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct connection - drizzle-kit migrations only.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# ---------- Authentication (Better Auth) ----------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-32-byte-secret
BETTER_AUTH_URL=http://localhost:3000

# ---------- Email ----------
EMAIL_MODE=preview
RESEND_API_KEY=
RESEND_FROM=

# ---------- Payments ----------
PAYMENT_MODE=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Real-time (Ably) ----------
ENABLE_ABLY=false
ABLY_API_KEY=

# ---------- Images (Cloudinary) ----------
ENABLE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Frontend ----------
VITE_PUBLIC_BASE_URL=http://localhost:3000