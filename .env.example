# ============================================================
# RestaurantOS — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local.
#
# .env.local is read by `vercel dev -L`.
# Vite exposes ONLY vars prefixed with VITE_ to the frontend.
# ============================================================

# ---------- Database (Neon) ----------
# Pooled connection — used by the app at runtime.
DATABASE_URL=postgresql://neondb_owner:npg_ZLRtdQq12XHB@ep-late-mountain-ba823u7s-pooler.c-8.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct connection — used by drizzle-kit migrations only.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# ---------- Authentication (Better Auth) ----------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=ZQUXbCJY0VyVF5VYpLtqQWOQdRsRyzd0VM7SGCcDAJ0=
BETTER_AUTH_URL=http://localhost:3000

# ---------- Email ----------
# preview = render to disk, no sending (default, $0 safe).
# resend  = send via Resend (requires API key + verified sender).
EMAIL_MODE=preview
RESEND_API_KEY=
RESEND_FROM=

# ---------- Payments ----------
# simulated   = in-process fake provider (default, $0 safe).
# stripe_test = Stripe test mode (requires test keys, never live keys).
PAYMENT_MODE=simulated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- Real-time (Ably) ----------
ENABLE_ABLY=false
ABLY_API_KEY=

# ---------- Images (Cloudinary) ----------
ENABLE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- Frontend (exposed to browser) ----------
VITE_PUBLIC_BASE_URL=http://localhost:3000