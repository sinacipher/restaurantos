    "@tanstack/react-table": "^9.3.1",
    "ably": "^2.30.0",
    "better-auth": "^1.7.18",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.0.0",
